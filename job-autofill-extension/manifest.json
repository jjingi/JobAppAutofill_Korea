{
  "manifest_version": 3,
  "name": "Job Application Autofill",
  "version": "0.1.0",
  "description": "Fill job application forms from saved profile data",
  "permissions": ["storage", "scripting", "activeTab", "unlimitedStorage"],
  "host_permissions": ["https://api.openai.com/*"],
  "action": {
    "default_title": "Job Autofill",
    "default_popup": "autofill-popup.html"
  },
  "options_page": "profile-settings.html"
}
